<?xml version="1.0" encoding="utf-8"?>
<!-- Window animation of an app opened from the launcher with the modern turnstile: the window swings in around its left edge as the tiles of Start have turned away (a flat squeeze stands for the turn, which a window cannot do). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <scale
        android:duration="420"
        android:fromXScale="0.4"
        android:fromYScale="1.0"
        android:interpolator="@android:interpolator/decelerate_cubic"
        android:pivotX="0%"
        android:pivotY="50%"
        android:toXScale="1.0"
        android:toYScale="1.0" />
    <alpha
        android:duration="220"
        android:fromAlpha="0.0"
        android:interpolator="@android:interpolator/decelerate_quad"
        android:toAlpha="1.0" />
</set>
