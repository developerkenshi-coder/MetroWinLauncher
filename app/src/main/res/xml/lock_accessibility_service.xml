<?xml version="1.0" encoding="utf-8"?>
<!--
    The screen lock service reads nothing: it asks for no window content and has no use for events. It only exists
    because Android lets a service, and nothing else, lock the screen (GLOBAL_ACTION_LOCK_SCREEN).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/lock_service_description"
    android:notificationTimeout="500" />
