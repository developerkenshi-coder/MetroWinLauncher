<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing of the launcher goes to a cloud backup or to a new phone by itself: its settings hold the sync passphrase
    and the address of the backup folder. The layout is carried between phones by the encrypted sync file or by a
    backup the user makes on purpose (Backup in the settings).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
