<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Everything below is optional for the launcher itself. The user is asked once, on a
        Metro-style page, and every permission only powers one live tile:
        Photos, Calendar, People and Phone (missed calls).
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- The file manager: it shows and changes every file of the phone, which is the whole of its job. Android 11 and later ask the user for it in a screen of the settings. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The wallet reads the code of a card with the camera (live, nothing is kept or sent). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- A recording goes on, with a notification, when the launcher is left. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- "Real-time mail": the connection that waits for new mail (IMAP IDLE), with a notification that can be stopped. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Only to ask, in the tutorial, that Android does not close the launcher to save battery. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!-- What an app asks for to put its own live content on its tile (see TilePublishProvider). -->
    <permission
        android:name="${applicationId}.permission.PUBLISH_TILE"
        android:description="@string/permission_publish_tile_description"
        android:label="@string/permission_publish_tile_label"
        android:protectionLevel="normal" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Taking a call out of the history of the dialer. -->
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- The screen of a call keeps the proximity lock that turns the screen off against the ear; without it that screen fails to open and Android uses another one. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Text messages: read and send them in the messages app of the launcher, and receive them once it is the messaging app of the phone. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <!-- The short vibration of a tap, when the launcher's setting for it is on. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Timer and reminders: the notification when they come due, the alarm that wakes it, and setting the alarms again after a reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- A phone that cannot call (a tablet) still runs the launcher: the dialer-based paths do not need it. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- The screen of a call coming in over the lock screen, once the launcher is the phone app. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Only to move the brightness slider of the Action Center: the user gives it in a screen of Android, never by a dialog. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <!--
        A launcher has to see every installed app. LauncherApps and the <queries> below already cover the
        apps that have a launcher icon; this makes the visibility complete (stock app lookups, work profile).
        Google Play restricts this permission and asks for a justification: check it before publishing.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!--
        The usage access: a switch the user turns on in a screen of Android. It lets the Apps, Data usage and Memory tiles read the time
        each app was used, the data used and the size of the apps. Nothing is read until the user gives it, and the tiles work without it.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        The weather tile asks Open-Meteo for the forecast of one city (nothing else is sent), and can use the last
        known position, only when you ask for "use my location".
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- The Metro banner of a new notification over other apps (off until the user turns it on and allows "display over other apps"). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Wi-Fi state on the Action Center button. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Connected and paired devices on the Bluetooth button of the Action Center (Android 12 asks for BLUETOOTH_CONNECT). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- "uninstall" in the app list context menu. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Updating from GitHub: the new APK is handed to the installer of Android, which asks the user to confirm. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The check for a new release runs only with a connection: Android wants this permission for a job with that condition. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Package visibility (Android 11+). The launcher activities of every app are listed through
        LauncherApps; the intents below let us find which installed app plays the role of the
        Windows Phone stock apps (Phone, People, Camera, ...).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Icon packs announce themselves with the intents of the big launchers. -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="com.anddoes.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="com.fede.launcher.THEME_ICONPACK" />
        </intent>
        <intent>
            <action android:name="com.gau.go.launcherex.theme" />
        </intent>
        <intent>
            <action android:name="org.adw.launcher.icons.ACTION_PICK_ICON" />
        </intent>
        <intent>
            <action android:name="ginlemon.smartlauncher.THEMES" />
        </intent>
        <intent>
            <action android:name="home.solo.launcher.free.THEMES" />
        </intent>
        <intent>
            <action android:name="com.dlto.atom.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="com.lge.launcher2.THEME" />
        </intent>
        <intent>
            <action android:name="net.oneplus.launcher.icons.ACTION_PICK_ICON" />
        </intent>
        <intent>
            <action android:name="app.lawnchair.icons.THEMED_ICON" />
        </intent>
        <intent>
            <action android:name="com.gridappsinc.launcher.theme.apk_action" />
        </intent>
        <intent>
            <action android:name="com.phonemetra.turbo.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.anddoes.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.novalauncher.category.CUSTOM_ICON_PICKER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.provider.MediaStore.RECORD_SOUND" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.BATTERY_SAVER_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.DATA_USAGE_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.INTERNAL_STORAGE_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_BROWSER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALCULATOR" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALENDAR" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CONTACTS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_EMAIL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_GALLERY" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MAPS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MESSAGING" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
    </queries>

    <application
        android:name=".MetroApp"
        android:requestLegacyExternalStorage="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MetroWin">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:enableOnBackInvokedCallback="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustPan|stateHidden">
            <!-- This is what makes the app selectable as the device's Home app. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A link shared from any browser is pinned to Start as a live tile of the site. -->
            <intent-filter android:label="@string/share_pin_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- The dialer: opened for "dial" and tel: links, and listed as an app of its own. Android needs both tel: filters to offer the launcher as the phone app. -->
        <activity
            android:name=".dialer.DialerActivity"
            android:exported="true"
            android:label="@string/dialer_app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- The mini apps that are only opened from the launcher (see MiniApps): not exported, nothing else may start them. -->
        <activity
            android:name=".calculator.CalculatorActivity"
            android:exported="false"
            android:label="@string/stock_calculator"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name=".notes.NotesActivity"
            android:exported="false"
            android:label="@string/stock_notes"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".todo.TodoActivity"
            android:exported="false"
            android:label="@string/stock_todo"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".recorder.RecorderActivity"
            android:exported="false"
            android:label="@string/recorder_default_label"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".calendar.CalendarActivity"
            android:exported="false"
            android:label="@string/stock_calendar"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".recents.RecentsActivity"
            android:exported="false"
            android:label="@string/rc_title"
            android:launchMode="singleTask"
            android:excludeFromRecents="true" />

        <activity
            android:name=".power.PowerActivity"
            android:exported="false"
            android:label="@string/pw_open"
            android:launchMode="singleTask"
            android:excludeFromRecents="true" />

        <activity
            android:name=".systemsettings.SystemSettingsActivity"
            android:exported="false"
            android:label="@string/stock_settings"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".shizukuterminal.ShizukuTerminalActivity"
            android:exported="false"
            android:label="@string/stock_shizukuterminal"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".datasense.DataSenseActivity"
            android:exported="false"
            android:label="@string/stock_datasense"
            android:launchMode="singleTask" />

        <activity
            android:name=".wallet.WalletActivity"
            android:exported="false"
            android:label="@string/stock_wallet"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".news.NewsActivity"
            android:exported="false"
            android:label="@string/stock_news"
            android:launchMode="singleTask" />

        <activity
            android:name=".people.PeopleActivity"
            android:exported="false"
            android:label="@string/stock_people"
            android:launchMode="singleTask" />

        <activity
            android:name=".music.NowPlayingActivity"
            android:exported="false"
            android:label="@string/stock_nowplaying"
            android:launchMode="singleTask" />

        <activity
            android:name=".photos.PhotosActivity"
            android:exported="false"
            android:label="@string/stock_photohub"
            android:launchMode="singleTask" />

        <activity
            android:name=".files.FilesActivity"
            android:exported="false"
            android:label="@string/stock_files"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- The messages app: opened for "send a message" links, and listed as an app of its own. Android needs all of the parts below to offer the launcher as the messaging app. -->
        <activity
            android:name=".messages.MessagesActivity"
            android:exported="true"
            android:label="@string/messages_app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".messages.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".messages.MmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>
        <receiver android:name=".messages.SmsReplyReceiver" android:exported="false" />
        <receiver android:name=".messages.SmsSentReceiver" android:exported="false" />
        <service android:name=".mail.MailIdleService" android:exported="false" android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps an IMAP IDLE connection open to the user's mail servers so that new mail is told at once; off by default, stopped from its notification." />
        </service>
        <service android:name=".recorder.RecorderService" android:exported="false" android:foregroundServiceType="microphone" />
        <service
            android:name=".messages.RespondViaMessageService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>


        <!-- The Metro Mail app -->
        <activity
            android:name=".mail.MailActivity"
            android:exported="true"
            android:label="@string/mail_app_title"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <!-- Where the page of Microsoft sends the browser back after the sign in (see MicrosoftOAuth). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.metrowin.launcher" android:host="oauth" />
            </intent-filter>
        </activity>

        <!-- The screen of the calls, shown by the in-call service below. -->
        <activity
            android:name=".calls.InCallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity="${applicationId}.incall" />

        <!-- Android hands every call to this service while the launcher is the phone app (see DialerRole). It rings the phone itself. -->
        <service
            android:name=".calls.MetroInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- The check for a new release on GitHub, every 12 hours while there is a connection, and the answer of the installer. -->
        <service
            android:name=".data.UpdateCheckJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- The look at the inbox of each mail account, every half hour while there is a connection. -->
        <service
            android:name=".mail.MailSyncJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- The look at the mobile data used, every hour while a limit is set. -->
        <service
            android:name=".datasense.DataLimitJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- A look at Shizuku every 15 minutes while buttons that need it are on. -->
        <service
            android:name=".data.ShizukuWatchJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- A reading of the battery every 15 minutes, for the history of the battery doctor, while the user keeps it on. -->
        <service
            android:name=".data.BatteryLogJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name=".data.UpdateResultReceiver"
            android:exported="false" />

        <!--
            Wakes at the moment of a timer or a reminder (an alarm of Android, so nothing runs in between), and once after a
            reboot or an update of the launcher to set the alarms again.
        -->
        <receiver
            android:name=".notifications.AlertReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The files the launcher sends through the share sheet (the layout, the theme): only the folder shared/ of its cache. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Shizuku hands its binder to the launcher through this provider, when the user runs Shizuku. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name=".data.TilePublishProvider"
            android:authorities="${applicationId}.tiles"
            android:exported="true"
            android:permission="${applicationId}.permission.PUBLISH_TILE" />

        <!-- The Metro lock screen, offered to Android as a screen saver. -->
        <service
            android:name=".ui.lock.MetroDreamService"
            android:exported="true"
            android:label="@string/lock_dream_label"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!--
            Lets the launcher lock the screen for a gesture. Turned on by the user in the accessibility settings;
            it reads nothing from the screen (see res/xml/lock_accessibility_service.xml).
        -->
        <service
            android:name=".gestures.LockAccessibilityService"
            android:exported="true"
            android:label="@string/lock_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_accessibility_service" />
        </service>

        <!-- The Recent apps tile for the Quick Settings (see RecentsTileService). -->
        <service
            android:name=".gestures.RecentsTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_recents"
            android:label="@string/qa_recents"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
            Reads the notifications for the Action Center and the counters on the tiles. Android only
            binds it once the user turns on "notification access" for this app.
        -->
        <service
            android:name=".notifications.NotificationService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
